# Порт API-сервера
PORT=3001

# Строка подключения к PostgreSQL (базу создайте заранее: createdb cat_therapy)
DATABASE_URL=postgres://postgres@localhost:5432/cat_therapy

# Секрет для подписи JWT — обязательно замените на длинную случайную строку
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Адрес фронтенда для CORS
CLIENT_ORIGIN=http://localhost:5173

# development — подробные логи; без SMTP код восстановления пишется в консоль сервера
NODE_ENV=development

# --- Почта (SMTP) для писем с кодом восстановления пароля ---
# Без SMTP_HOST письма не отправляются: в development код пишется в консоль сервера,
# в production запрос кода вернёт ошибку.
# Gmail: smtp.gmail.com, 465, пароль — «пароль приложения» (myaccount.google.com/apppasswords, нужна 2FA)
# Яндекс: smtp.yandex.ru, 465, пароль приложения из id.yandex.ru → Безопасность
# Mail.ru: smtp.mail.ru, 465, пароль для внешних приложений
SMTP_HOST=
SMTP_PORT=465
# true для 465 (TLS), false для 587 (STARTTLS); по умолчанию определяется по порту
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Отправитель; у Gmail/Яндекса должен совпадать с SMTP_USER
MAIL_FROM="Котики-терапевты <you@example.com>"
